# Copy to .env and fill in. Never commit .env.

# Postgres with pgvector. Supabase: Project Settings → Database → Connection string → URI
# Use the direct connection or the pooler in SESSION mode. Transaction mode (port 6543)
# will not work — the checkpointer relies on prepared statements.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Anthropic — generation. Not needed for ingestion.
ANTHROPIC_API_KEY=sk-ant-...

# Google — the eval judge only. Not needed to serve requests.
GEMINI_API_KEY=

# Embeddings and reranking run locally — no API key needed.
# Defaults live in app/config.py; override here only to experiment.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=BAAI/bge-reranker-large
# GENERATION_MODEL=claude-haiku-4-5
# REQUEST_TIMEOUT=90

# Chunking
CHUNK_TOKENS=400
CHUNK_OVERLAP=50

# Connection pools. A process holds up to (DB_POOL_MAX_SIZE + CHECKPOINT_POOL_MAX_SIZE)
# connections, and `uvicorn --workers N` multiplies that — check it against your
# database's connection limit before raising either.
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=8
# CHECKPOINT_POOL_MAX_SIZE=4

# Conversation context. Past this many tokens, older tool results are dropped from what
# is resent to the model; the most recent few are kept.
# CONTEXT_EDIT_TRIGGER_TOKENS=24000
# CONTEXT_EDIT_KEEP_TOOL_RESULTS=3

# Stamped onto traces so a metric change can be tied to the prompt that produced it.
# PROMPT_VERSION=2026-08-13

# Langfuse tracing — keys at https://cloud.langfuse.com (Settings → API Keys).
# Blank keys disable tracing; the app runs fine without them.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
