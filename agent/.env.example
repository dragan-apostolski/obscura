# Copy to .env and fill in. Never commit .env.

# Supabase Postgres connection string (Project Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Anthropic — generation (Claude), used from L03. Blank is fine for L01 ingestion.
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings run locally (free, offline) — no API key needed.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GENERATION_MODEL=claude-sonnet-5

# Chunking defaults (L01)
CHUNK_TOKENS=400
CHUNK_OVERLAP=50

# Langfuse (added in L08 — leave blank for now)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
